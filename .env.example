# Copy to .env and fill in real values. .env is git-ignored; this file is not.
#
# Build-time configuration only — nothing here is bundled into the apps.
# Do NOT put IPTV subscription credentials here: users enter them in the app.

# Android release signing (path relative to the repository root).
# Create a key with:
#   keytool -genkeypair -keystore IPTVXtremeAndroid/release.keystore -alias iptvxtreme \
#           -keyalg RSA -keysize 2048 -validity 10000
ANDROID_KEYSTORE_FILE=IPTVXtremeAndroid/release.keystore
ANDROID_KEYSTORE_PASSWORD=change-me
ANDROID_KEY_ALIAS=iptvxtreme
ANDROID_KEY_PASSWORD=change-me

# macOS build: location of VLC.app (supplies libVLC at build time)
VLC_APP_PATH=/Applications/VLC.app
